{% comment %}
  Renders one CV block from _data/cv.yml according to its `type`; expects `entry`.
{% endcomment %}
{% if entry.type == 'list' %}
  {% include cv/list.liquid %}
{% elsif entry.type == 'map' %}
  {% include cv/map.liquid %}
{% elsif entry.type == 'nested_list' %}
  {% include cv/nested_list.liquid %}
{% elsif entry.type == 'time_table' %}
  {% include cv/time_table.liquid %}
{% elsif entry.type == 'list_groups' %}
  {% include cv/list_groups.liquid %}
{% elsif entry.type == 'bibliography' %}
  {% include publications_by_type.liquid exclude=entry.exclude only=entry.only heading_tag='h5' %}
{% else %}
  {{ entry.contents }}
{% endif %}
